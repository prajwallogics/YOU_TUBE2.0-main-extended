# Replace <password> with the password for the Atlas database user. URL-encode
# special password characters (for example, @ becomes %40).
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/yourtube?retryWrites=true&w=majority&appName=yourtube
PORT=5000

# Test keys come from Razorpay Dashboard -> Settings -> API Keys.
# Never expose RAZORPAY_KEY_SECRET to the frontend or commit it.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# SMTP settings used to email a payment-confirmation invoice after a successful
# Razorpay payment. For Gmail, use smtp.gmail.com, port 465, and an App Password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=YourTube <no-reply@example.com>
